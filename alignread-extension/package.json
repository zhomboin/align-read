{
  "name": "alignread-extension",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "wxt --browser chrome --mv3",
    "build": "wxt build --browser chrome --mv3",
    "zip": "wxt zip --browser chrome --mv3",
    "check": "wxt prepare && tsc --noEmit",
    "test:settings": "node tests/release-check.cjs --settings",
    "test:selection": "node tests/release-check.cjs --selection",
    "test:release": "node tests/release-check.cjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "~5.9.3",
    "wxt": "0.21.5"
  }
}
